# Example environment for running the Samba AD DC appliance through
# lab-kit's generic runner. The Samba repo maintains the working copy of
# this file at samba-addc-appliance/lab/samba.env; this is just a reference
# example of how an appliance wires into lab-kit.

LAB_NAME=samba-addc
LAB_RESULTS_DIR=../samba-addc-appliance/test-results

# Hyper-V target.
LAB_HV_HOST=server
LAB_HV_USER=labadmin

# VM under test.
LAB_VM_NAME=samba-dc1
LAB_VM_IP=10.10.10.20
LAB_VM_USER=debadmin
LAB_GOLDEN_CHECKPOINT=golden-image

# Host-side share where helper scripts get staged. Must contain
# Revert-TestVM.ps1 (from lab-kit) before the reset step can run.
# LAB_STAGE_DIR is how the Mac sees the share; LAB_HOST_STAGE_DIR is how
# the Hyper-V host sees it (for pwsh invocations over ssh).
LAB_STAGE_DIR=/Volumes/ISO/lab-scripts
LAB_HOST_STAGE_DIR='D:\ISO\lab-scripts'

# Globs are shell-expanded and copied to LAB_STAGE_DIR on every run.
LAB_STAGE_SOURCES="../samba-addc-appliance/lab/*.ps1 \
                   ../samba-addc-appliance/lab/*.xml \
                   ../lab-kit/hypervisors/hyperv/*.ps1 \
                   ../lab-router/hypervisors/hyperv/*.ps1"

# Appliance scripts scp'd into the VM before the scenario runs.
LAB_PUSH_FILES="../samba-addc-appliance/prepare-image.sh ../samba-addc-appliance/samba-sconfig.sh"
LAB_REMOTE_PUSH_DIR=/tmp

# Remote command run on the VM after push.
LAB_POST_PUSH_CMD='sudo install -m 0755 /tmp/samba-sconfig.sh /usr/local/sbin/samba-sconfig'
